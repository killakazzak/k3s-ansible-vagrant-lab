# Runtime state and credentials
.vagrant/
kubeconfig
kubeconfig.*
admin.conf
super-admin.conf
*.key
*.pem
*.p12
*.pfx
*.crt
private_key
id_rsa*
id_ed25519*
.env
.env.*
!.env.example

# Local diagnostics and backups
*.log
*.retry
*.bak
*.before-*
.DS_Store
.venv/
__pycache__/

# Local CLI downloads
.tools/

.cache/

# Independent cluster configurations, VM state and secrets
.clusters/

# Offline release archives (distributed through GitHub Releases)
vendor/offline/
.offline-venv/

# Keep the pinned macOS installer in Git.
vendor/vagrant/*.dmg
!vendor/vagrant/vagrant_2.4.9_darwin_arm64.dmg

# Keep only the pinned Ubuntu installer in Git.
vendor/vagrant/*.deb
!vendor/vagrant/vagrant_2.4.9-1_amd64.deb

# Imported remote cluster credentials
.connections/
